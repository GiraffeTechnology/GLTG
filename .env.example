# GLTG -- Giraffe Lead-Time Graph standalone service
#
# The core Python library needs no environment variables (all configuration is
# passed via request/object inputs). These variables configure the HTTP service.

GLTG_HOST=0.0.0.0
GLTG_PORT=8090

# ---------------------------------------------------------------------------
# giraffe-db evidence + run persistence (Stage 3)
# ---------------------------------------------------------------------------
# When set, GLTG can retrieve tenant-scoped supplier evidence
# (evidence.use_giraffe_db=true in v2 requests) and persist runs. Never commit
# a real secret; the value is sent as X-Service-Auth.
GLTG_GIRAFFE_DB_BASE_URL=
GLTG_GIRAFFE_DB_SERVICE_AUTH_SECRET=
GLTG_GIRAFFE_DB_TIMEOUT_SECONDS=5
# Persist v2 runs to giraffe-db (gltg_simulation_runs). Persistence status is
# always reported truthfully in response.persistence.status.
GLTG_PERSIST_RUNS=false

# aivan integration (supplier signal iteration)
AIVAN_BASE_URL=http://localhost:8765
AIVAN_TIMEOUT=30

# ---------------------------------------------------------------------------
# Evaluator mode
# ---------------------------------------------------------------------------
# deterministic (default) -- the explainable rule engine; no LLM calls, ever.
# llm                     -- explicit opt-in LLM-assisted evaluation.
# fallback                -- deprecated alias of deterministic.
GLTG_EVALUATOR_MODE=deterministic

# LLM settings apply only when GLTG_EVALUATOR_MODE=llm.
# provider: qwen | openai_compatible | anthropic | gemini | deepseek | local | mock
GLTG_LLM_PROVIDER=qwen
GLTG_LLM_MODEL=qwen3.5:2b
GLTG_LLM_BASE_URL=
GLTG_LLM_API_KEY=
GLTG_LLM_TIMEOUT_SECONDS=30
GLTG_LLM_MAX_RETRIES=2
GLTG_LLM_TEMPERATURE=0
GLTG_LLM_JSON_MODE=true
GLTG_LLM_STRICT_SCHEMA=true
# If the LLM provider fails and this is false, GLTG returns a controlled
# manual-review assessment instead of silently using hard-coded formulas.
GLTG_ALLOW_RULE_FALLBACK=false
# Deterministic mock scenario for CI/local testing (mock provider only).
GLTG_MOCK_SCENARIO=valid
